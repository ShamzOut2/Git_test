{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apex Overlays",
  "mainBinaryName": "Apex Overlays",
  "version": "0.3.0",
  "identifier": "app.apexoverlays.desktop",
  "build": {
    "frontendDist": "static"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Apex Overlays",
    "shortDescription": "Lightweight, fully customisable iRacing overlays",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
